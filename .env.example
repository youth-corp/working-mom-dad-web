# --- Runtime ---
NEXT_PUBLIC_APP_ENV=development

# --- API ---
# api(NestJS) dev 포트 = 3001 (web=3000 / api=3001 / admin=3002)
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"

# --- Supabase Auth (client) ---
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# --- Analytics ---
# GA4 측정 ID. 값이 있을 때만 GA가 로드된다 (production 환경에만 등록 권장).
NEXT_PUBLIC_GA_ID=""

# Amplitude Browser SDK API Key. 공개 클라이언트 키이므로 production/staging 프로젝트를 분리한다.
# 값이 비어 있으면 Amplitude는 초기화·전송되지 않는다.
NEXT_PUBLIC_AMPLITUDE_API_KEY="YOUR_AMPLITUDE_BROWSER_API_KEY"
# Performance baseline (opt-in); use 1 for a bounded QA baseline, lower for production.
NEXT_PUBLIC_PERFORMANCE_ENABLED="false"
NEXT_PUBLIC_PERFORMANCE_SAMPLE_RATE="1"
# Vercel builds default to VERCEL_GIT_COMMIT_SHA; set for local production builds.
NEXT_PUBLIC_PERFORMANCE_RELEASE=""
# Server-side /me timing in Vercel logs (separate from browser sampling).
PERFORMANCE_ENABLED="false"
